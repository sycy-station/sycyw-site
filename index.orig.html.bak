<!DOCTYPE html>
<html lang="zh-CN" data-wide="on">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>森韵次元坞 — 极简系统实验室</title>
<meta name="description" content="森韵次元坞，一个专注于极简系统与界面的实验室。">
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="stage.css">
<!-- 大屏装饰层，可整行删除 -->
<link rel="stylesheet" href="wide.css">
<!-- 深色模式调色板，可整行删除 -->
<link rel="stylesheet" href="theme.css">
<!-- 主题必须在首帧前定好，否则深色偏好的用户会先看到一帧白底。
     故意内联且放在样式表之后：这段极短，阻塞可忽略。
     无此脚本时 theme.css 的 @media 仍会跟随系统，只是失去手动选择。 -->
<script>
  (function () {
    try {
      var t = localStorage.getItem("ces-theme");
      if (t === "dark" || t === "light") {
        document.documentElement.setAttribute("data-theme", t);
      }
    } catch (e) {
      /* 隐私模式下 localStorage 可能抛异常，落回系统偏好即可 */
    }
  })();
</script>
<noscript>
  <!-- 脚本不可用时，直接展示完整内容，不让开屏黑幕和揭示动画把页面锁死 -->
  <style>
    .splash { display: none !important; }
    .reveal-line, .reveal-item { opacity: 1 !important; transform: none !important; }
    .orbit-inner, .stage-logo-name, .stage-scroll { opacity: 1 !important; transform: none !important; }
    .deco .splash-grid { opacity: 0.045 !important; }
    .deco .fr { opacity: 0.55 !important; transform: translate(0, 0) !important; }
    .orbit-ring { opacity: 0.15 !important; }
    .orbit-ticks { opacity: 0.3 !important; }
    /* 无 JS 时星球不公转，停在 12 点；环仍然画出来 */
    .orbit-planet-ring { opacity: 0.1 !important; }
    .orbit-planet { opacity: 1 !important; }
    .stage-foot { opacity: 1 !important; }
    .sf-line { transform: scaleX(1) !important; }
    /* 无 JS 时 body.sp-* 不会被加上，wide 两层会停在 opacity:0 */
    .deco .wide-guides { opacity: 0.12 !important; }
    .deco .wide-scale { opacity: 0.4 !important; }
    .deco .wide-hlines { opacity: 0.085 !important; }
    .deco .wide-edge { opacity: 0.42 !important; }
    .cursor { display: none !important; }
    /* 主题开关依赖 JS，无脚本时不显示（body.has-theme-toggle 也加不上，
       这里再声明一次是为了意图明确） */
    .theme-toggle { display: none !important; }
  </style>
</noscript>
</head>
<body>

  <!-- 噪点纹理层，弱化纯平面模板感 -->
  <div class="noise" aria-hidden="true"></div>

  <!-- 自定义反色光标 -->
  <div class="cursor" aria-hidden="true"></div>

  <!-- 开屏动画 -->
  <div class="splash" id="splash" aria-hidden="true">
    <div class="splash-bg"></div>

    <!-- ==================== WIDE-SCREEN DECOR / 大屏装饰层 ====================
         整块可删除。或把 <html data-wide="on"> 改成 "off" 即可全部关闭。
         A 层：通栏蜂巢底纹 + 垂直参考线 + 坐标标注
         B 层：左右边缘信息带（全高刻度尺 + 数字标注 + 竖排技术串）
         ======================================================================= -->
    <div class="wide" aria-hidden="true">

      <!-- A：参考线与坐标（蜂巢底纹只保留 style.css 里的中心那一层） -->
      <div class="wide-guides"></div>
      <div class="wide-hlines"></div>
      <div class="wide-scale"><span>X:0000</span><span>X:0320</span><span>X:0640</span><span>X:0960</span><span>X:1280</span><span>X:1600</span><span>X:1920</span><span>X:2240</span><span>X:2560</span><span>X:2880</span><span>X:3200</span><span>X:3520</span></div>

      <!-- B：左右边缘信息带 -->
      <div class="wide-edge wide-edge-l">
        <span class="we-rail"><i></i></span>
        <span class="we-marks"><span>0100</span><span>0200</span><span>0300</span><span>0400</span><span>0500</span><span>0600</span><span>0700</span><span>0800</span></span>
        <span class="we-vtext">SYCYW&nbsp;·&nbsp;INTERFACE&nbsp;LAB&nbsp;·&nbsp;GRID&nbsp;0417</span>
      </div>

      <div class="wide-edge wide-edge-r">
        <span class="we-rail"><i></i></span>
        <span class="we-marks"><span>0800</span><span>0700</span><span>0600</span><span>0500</span><span>0400</span><span>0300</span><span>0200</span><span>0100</span></span>
        <span class="we-vtext">CELL&nbsp;ARRAY&nbsp;·&nbsp;REV&nbsp;2.31&nbsp;·&nbsp;LOCK&nbsp;OK</span>
      </div>

    </div>
    <!-- ==================== /WIDE-SCREEN DECOR ==================== -->

    <!-- 技术质感层：蜂巢和括号是开屏里的「前景」副本，溶解时淡出。
         .stage 内的 .deco 是跨接缝存活的「后景」副本，在 splash-bg 透明后接住。-->
    <div class="splash-grid" aria-hidden="true"></div>

    <div class="splash-frame" aria-hidden="true">
      <span class="fr fr-tl"></span><span class="fr fr-tr"></span>
      <span class="fr fr-bl"></span><span class="fr fr-br"></span>
    </div>

    <div class="splash-rule splash-rule-t" aria-hidden="true"></div>
    <div class="splash-rule splash-rule-b" aria-hidden="true"></div>

    <!-- 四角读数：状态机、序列号、坐标、进度 -->
    <div class="hud" aria-hidden="true">
      <div class="hud-tl">
        <span class="hud-k">STATUS</span>
        <span class="hud-v" id="hudStatus">INIT</span>
      </div>
      <div class="hud-tr">
        <span class="hud-k">SEQ</span>
        <span class="hud-v" id="hudSeq">0x0000</span>
      </div>
      <div class="hud-bl">
        <span class="hud-k">NODE</span>
        <span class="hud-v">SYCYW<span class="hud-coord">&nbsp;/&nbsp;31.23N&nbsp;121.47E</span></span>
      </div>
      <div class="hud-br">
        <span class="hud-v" id="hudPct">000</span>
        <span class="hud-bar"><i id="hudBar"></i></span>
      </div>
    </div>

    <div class="splash-content">
      <!-- 三栏网格：侧标题 / logo / 侧标题，侧标题初始向 logo 中心收拢 -->
      <div class="splash-stage">
        <div class="splash-side splash-side-left">
          <span class="side-no">MODULE&nbsp;01</span>
          <span class="side-title">极简系统</span>
          <span class="side-sub">MINIMAL&nbsp;SYSTEM</span>
        </div>

        <div class="splash-logo-wrap">
          <span class="reticle" aria-hidden="true">
            <i class="rt rt-tl"></i><i class="rt rt-tr"></i>
            <i class="rt rt-bl"></i><i class="rt rt-br"></i>
            <i class="rt-tick rt-tick-t"></i><i class="rt-tick rt-tick-b"></i>
            <i class="rt-tick rt-tick-l"></i><i class="rt-tick rt-tick-r"></i>
          </span>
          <img class="splash-logo" src="assets/logo.png" alt="" width="1000" height="1000" decoding="async">
        </div>

        <div class="splash-side splash-side-right">
          <span class="side-no">MODULE&nbsp;02</span>
          <span class="side-title">界面实验室</span>
          <span class="side-sub">INTERFACE&nbsp;LAB</span>
        </div>

        <!-- 左右数据面板：填充 expand 之前的空栏，expand 时退场让位给侧标题 -->
        <div class="panel panel-left" aria-hidden="true">
          <span class="panel-rail"><i></i><span class="panel-seq">SEQ-0417</span></span>
          <div class="panel-body">
            <span class="panel-label">SPEC&nbsp;/&nbsp;01</span>
            <span class="panel-bars">
              <i style="--w:78%"></i><i style="--w:54%"></i><i style="--w:91%"></i>
              <i style="--w:36%"></i><i style="--w:67%"></i>
            </span>
            <span class="panel-hex">
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            </span>
            <span class="panel-read">
              <span><b>CELL</b><em>0417</em></span>
              <span><b>FLUX</b><em>2.31</em></span>
              <span><b>TEMP</b><em>036</em></span>
            </span>
            <span class="panel-foot">GRID&nbsp;LOCK&nbsp;·&nbsp;OK</span>
          </div>
        </div>

        <div class="panel panel-right" aria-hidden="true">
          <span class="panel-rail"><i></i><span class="panel-seq">REV-2.31</span></span>
          <div class="panel-body">
            <span class="panel-label">SPEC&nbsp;/&nbsp;02</span>
            <span class="panel-bars">
              <i style="--w:62%"></i><i style="--w:88%"></i><i style="--w:44%"></i>
              <i style="--w:73%"></i><i style="--w:29%"></i>
            </span>
            <span class="panel-hex">
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            </span>
            <span class="panel-read">
              <span><b>NODE</b><em>08</em></span>
              <span><b>GAIN</b><em>1.04</em></span>
              <span><b>DRIFT</b><em>000</em></span>
            </span>
            <span class="panel-foot">CELL&nbsp;ARRAY&nbsp;·&nbsp;OK</span>
          </div>
        </div>
      </div>

      <!-- 名称与代码：放大阶段退场，把画面让给 logo 与侧标题 -->
      <div class="splash-meta">
        <div class="splash-name">
          <span class="splash-letter">森</span>
          <span class="splash-letter">韵</span>
          <span class="splash-letter">次</span>
          <span class="splash-letter">元</span>
          <span class="splash-letter">坞</span>
        </div>
        <div class="splash-line"></div>
        <div class="splash-caption">
          <span class="cap-br">[</span>
          <span>STUDIO&nbsp;/&nbsp;LAB</span>
          <span class="cap-br">]</span>
        </div>
        <div class="splash-code" id="splashCode"></div>
      </div>

      <!-- 底部状态块：expand 阶段进场，填补 meta 撤走后的下半屏。
           三段构成厚度：主状态行 / 读数列 / 刻度条 -->
      <div class="statusbar" aria-hidden="true">

        <div class="sb-main">
          <i class="sb-line"></i>
          <span class="sb-text">
            <span class="sb-seg">SYSTEM&nbsp;READY</span>
            <span class="sb-dot">·</span>
            <span class="sb-seg">06&nbsp;MODULES</span>
            <span class="sb-dot">·</span>
            <span class="sb-seg">GRID&nbsp;LOCK&nbsp;OK</span>
          </span>
          <i class="sb-line"></i>
        </div>

        <div class="sb-cols">
          <span class="sb-col"><b>CELL</b><em>0417</em></span>
          <span class="sb-col"><b>FLUX</b><em>2.31</em></span>
          <span class="sb-col"><b>NODE</b><em>08</em></span>
          <span class="sb-col"><b>GAIN</b><em>1.04</em></span>
          <span class="sb-col"><b>TEMP</b><em>036</em></span>
          <span class="sb-col"><b>DRIFT</b><em>000</em></span>
        </div>

        <div class="sb-ticks"><i></i></div>
      </div>
    </div>
  </div>

  <!-- 角标式导航，非通栏 -->
  <header class="site-header">
    <a class="mark" href="#top"><span>森韵次元坞</span><span class="mark-dot">·</span></a>
    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" aria-label="切换深色模式" aria-pressed="false">
        <i aria-hidden="true"></i>
      </button>
      <button class="menu-toggle" id="menuToggle" aria-label="打开菜单" aria-expanded="false">
        <span></span>
      </button>
    </div>
  </header>

  <!-- 全屏覆盖式菜单 -->
  <nav class="overlay-nav" id="overlayNav" aria-hidden="true" aria-label="主导航">
    <ol class="overlay-list">
      <li><a href="#index" data-index="01">索引</a></li>
      <li><a href="#manifesto" data-index="02">观点</a></li>
      <li><a href="#contact" data-index="03">联系</a></li>
      <li><a href="#stage" data-index="04">分区</a></li>
    </ol>
    <div class="overlay-foot">
      <span class="clock" id="clock">--:--:--</span>
      <span>Shanghai, CN</span>
    </div>
  </nav>

  <main id="top">

    <!-- 分区页：承接开屏最后一帧，logo 原位不动，六个二级标题绕 logo 成弧线排布 -->
    <section class="stage" id="stage">

      <!-- 跨接缝装饰层：这两层从开屏一直活到分区页，中途不重建、不淡出，
           所以接缝处「环境」没有变化。随 stage 一起滚走。 -->
      <div class="deco" aria-hidden="true">
        <div class="splash-grid"></div>
        <div class="splash-frame">
          <span class="fr fr-tl"></span><span class="fr fr-tr"></span>
          <span class="fr fr-bl"></span><span class="fr fr-br"></span>
        </div>

        <!-- 大屏装饰层的后景副本：和上面 splash 里那份同参数，
             开屏期间被 .splash-bg 挡住，bg 淡出后接住，之后留在分区页填两侧死区。
             撤回时与 splash 里那份一并删除。 -->
        <div class="wide">

          <!-- A：参考线与坐标（蜂巢底纹只保留 style.css 里的中心那一层） -->
          <div class="wide-guides"></div>
          <div class="wide-hlines"></div>
          <div class="wide-scale"><span>X:0000</span><span>X:0320</span><span>X:0640</span><span>X:0960</span><span>X:1280</span><span>X:1600</span><span>X:1920</span><span>X:2240</span><span>X:2560</span><span>X:2880</span><span>X:3200</span><span>X:3520</span></div>

          <!-- B：左右边缘信息带 -->
          <div class="wide-edge wide-edge-l">
            <span class="we-rail"><i></i></span>
            <span class="we-marks"><span>0100</span><span>0200</span><span>0300</span><span>0400</span><span>0500</span><span>0600</span><span>0700</span><span>0800</span></span>
            <span class="we-vtext">SYCYW&nbsp;·&nbsp;INTERFACE&nbsp;LAB&nbsp;·&nbsp;GRID&nbsp;0417</span>
          </div>

          <div class="wide-edge wide-edge-r">
            <span class="we-rail"><i></i></span>
            <span class="we-marks"><span>0800</span><span>0700</span><span>0600</span><span>0500</span><span>0400</span><span>0300</span><span>0200</span><span>0100</span></span>
            <span class="we-vtext">CELL&nbsp;ARRAY&nbsp;·&nbsp;REV&nbsp;2.31&nbsp;·&nbsp;LOCK&nbsp;OK</span>
          </div>
        </div>
      </div>

      <div class="stage-orbit">

        <!-- 轨道环：半径等于六项的公转半径，让六项从「漂浮」变成「在环上」 -->
        <span class="orbit-ring" aria-hidden="true"></span>
        <span class="orbit-ticks" aria-hidden="true"></span>

        <!-- 星球轨道：半径落在 logo 边缘与六项内缘之间的空带上。
             底部挖掉一段，避开 logo 下方的名称，不让静态圆线切字。 -->
        <span class="orbit-planet-ring" aria-hidden="true"></span>
        <!-- 像素星球：9 档灰的 7x7 方格盘，受光面在左上。
             位置由 script.js 的 rAF 循环写 transform，顺时针公转，
             指向/聚焦某项时按最近路径停到该方向。 -->
        <span class="orbit-planet" aria-hidden="true">
          <svg viewBox="0 0 7 7" width="16" height="16" focusable="false" aria-hidden="true">
            <g fill="var(--planet-1)">
              <rect x="2" y="0" width="2" height="1"/>
              <rect x="1" y="1" width="2" height="1"/>
              <rect x="0" y="2" width="2" height="1"/>
              <rect x="0" y="3" width="1" height="1"/>
            </g>
            <g fill="var(--planet-2)">
              <rect x="4" y="0" width="1" height="1"/>
              <rect x="3" y="1" width="2" height="1"/>
              <rect x="2" y="2" width="3" height="1"/>
              <rect x="1" y="3" width="3" height="1"/>
              <rect x="1" y="4" width="2" height="1"/>
              <rect x="2" y="5" width="1" height="1"/>
            </g>
            <g fill="var(--planet-3)">
              <rect x="5" y="1" width="1" height="1"/>
              <rect x="5" y="2" width="2" height="1"/>
              <rect x="4" y="3" width="3" height="1"/>
              <rect x="3" y="4" width="3" height="1"/>
              <rect x="3" y="5" width="2" height="1"/>
              <rect x="2" y="6" width="3" height="1"/>
            </g>
          </svg>
        </span>

        <div class="stage-logo-wrap">
          <img class="stage-logo" src="assets/logo.png" alt="森韵次元坞" width="1000" height="1000">
          <span class="stage-logo-name">森韵次元坞</span>
        </div>

        <a class="orbit-item pos-1" href="#index">
          <span class="orbit-inner">
            <span class="orbit-no">01</span>
            <span class="orbit-title">系统设计</span>
            <span class="orbit-sub">SYSTEM&nbsp;DESIGN</span>
          </span>
        </a>
        <a class="orbit-item pos-2" href="#index">
          <span class="orbit-inner">
            <span class="orbit-no">02</span>
            <span class="orbit-title">交互研究</span>
            <span class="orbit-sub">INTERACTION</span>
          </span>
        </a>
        <a class="orbit-item pos-3" href="#index">
          <span class="orbit-inner">
            <span class="orbit-no">03</span>
            <span class="orbit-title">品牌语言</span>
            <span class="orbit-sub">BRAND&nbsp;VOICE</span>
          </span>
        </a>
        <a class="orbit-item pos-4" href="#index">
          <span class="orbit-inner">
            <span class="orbit-no">04</span>
            <span class="orbit-title">前端工程</span>
            <span class="orbit-sub">ENGINEERING</span>
          </span>
        </a>
        <a class="orbit-item pos-5" href="#manifesto">
          <span class="orbit-inner">
            <span class="orbit-no">05</span>
            <span class="orbit-title">动效编排</span>
            <span class="orbit-sub">MOTION</span>
          </span>
        </a>
        <a class="orbit-item pos-6" href="#contact">
          <span class="orbit-inner">
            <span class="orbit-no">06</span>
            <span class="orbit-title">实验归档</span>
            <span class="orbit-sub">ARCHIVE</span>
          </span>
        </a>

      </div>

      <!-- 底部信息带：补 orbit 弧线区与滚动提示之间的纵向空白 -->
      <div class="stage-foot" aria-hidden="true">
        <i class="sf-line"></i>
        <span class="sf-text">
          <span class="sf-seg">SYCYW</span>
          <span class="sf-dot">·</span>
          <span class="sf-seg">EST&nbsp;2019</span>
          <span class="sf-dot">·</span>
          <span class="sf-seg">REV&nbsp;2.31</span>
          <span class="sf-dot">·</span>
          <span class="sf-seg">31.23N&nbsp;121.47E</span>
        </span>
        <i class="sf-line"></i>
      </div>

      <div class="stage-scroll">
        <span>向下滚动</span>
        <i></i>
      </div>
    </section>

    <!-- 首屏：非居中大字标题 -->
    <section class="hero">
      <p class="hero-eyebrow reveal-line"><span class="num">00</span> — 关于</p>
      <h1 class="hero-title">
        <span class="line reveal-line">设计与工程之间</span>
        <span class="line reveal-line">没有边界。</span>
      </h1>
      <p class="hero-desc reveal-line">
        森韵次元坞是一个专注于极简系统与界面的实验室。
        我们相信少即是多，克制本身就是一种表达方式。
      </p>
      <div class="hero-scroll">
        <span>向下滚动</span>
        <i></i>
      </div>
    </section>

    <!-- 索引式列表，替代常见的三卡片布局 -->
    <section class="index-section" id="index">
      <h2 class="section-title reveal-line"><span class="num">01</span> 索引</h2>
      <ul class="index-list">
        <li class="index-item reveal-item">
          <span class="index-no">01</span>
          <span class="index-name">系统设计</span>
          <span class="index-desc">结构化的界面逻辑与组件体系</span>
          <span class="index-year">2024</span>
        </li>
        <li class="index-item reveal-item">
          <span class="index-no">02</span>
          <span class="index-name">交互研究</span>
          <span class="index-desc">动效节奏与真实的操作反馈</span>
          <span class="index-year">2024</span>
        </li>
        <li class="index-item reveal-item">
          <span class="index-no">03</span>
          <span class="index-name">品牌语言</span>
          <span class="index-desc">克制而清晰的视觉表达系统</span>
          <span class="index-year">2023</span>
        </li>
        <li class="index-item reveal-item">
          <span class="index-no">04</span>
          <span class="index-name">前端工程</span>
          <span class="index-desc">不依赖框架的轻量实现方式</span>
          <span class="index-year">2023</span>
        </li>
      </ul>
    </section>

    <!-- 观点/manifesto 分段排版 -->
    <section class="manifesto" id="manifesto">
      <h2 class="section-title reveal-line"><span class="num">02</span> 观点</h2>
      <div class="manifesto-grid">
        <p class="manifesto-text reveal-line">
          <span class="drop-cap">我</span>们不追逐流行的视觉语言，
          也不堆叠不必要的装饰。真正的设计感，
          来自于对留白、节奏和秩序的耐心打磨。
        </p>
        <p class="manifesto-text reveal-line">
          一个页面的好坏，不取决于它用了多少组件，
          而取决于它有没有被认真地思考过每一处间距、
          每一次过渡、每一个字号的选择。
        </p>
      </div>
    </section>

